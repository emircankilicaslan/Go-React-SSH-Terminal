# Backend ortam değişkenleri (kopyalayıp .env yapın; .env asla commit edilmez)

# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_SECRET=

# 32 baytlık anahtarın base64 hali (AES-256-GCM). Üretmek için: openssl rand -base64 32
# Kaybedilirse kayıtlı SSH şifreleri çözülemez.
ENCRYPTION_KEY=

# Virgülle ayrılmış, izin verilen tarayıcı kaynakları (CORS ve WebSocket origin kontrolü)
ALLOWED_ORIGINS=http://localhost:5173

PORT=8080
DB_PATH=data/fullstackx.db